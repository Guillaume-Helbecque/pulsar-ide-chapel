{
  "name": "pulsar-ide-chapel",
  "version": "0.2.1",
  "description": "Chapel language support for Pulsar",
  "main": "./lib/main",
  "keywords": [
    "ide",
    "chapel",
    "pulsar",
    "programming language",
    "language server",
    "linter"
  ],
  "author": "Guillaume Helbecque",
  "repository": "https://github.com/Guillaume-Helbecque/pulsar-ide-chapel",
  "license": "BSD-3-Clause",
  "engines": {
    "pulsar": ">=1.100.0"
  },
  "activationHooks": [
    "source.chapel:root-scope-used"
  ],
  "consumedServices": {
	  "linter-indie": {
	    "versions": {
	      "2.0.0": "consumeLinterV2"
	    }
	  }
	},
  "dependencies": {
    "@savetheclocktower/atom-languageclient": "^1.18.0"
  },
  "configSchema": {
	  "chapel_home_directory": {
	    "type": "string",
	    "default": "",
      "description": "Path to CHPL_HOME. If not provided, the package may be able to find it automatically if `chpl-language-server` is provided or in PATH."
	  },
	  "enable_chapel_language_server": {
  		"type": "boolean",
  		"default": true,
  		"description": "Enable the Chapel language server."
    },
    "chapel_language_server_path": {
  		"type": "string",
  		"default": "",
  		"description": "Path to the chpl-language-server executable."
    },
    "enable_chplcheck": {
  		"type": "boolean",
  		"default": true,
  		"description": "Enable chplcheck diagnostics."
    }
  }
}
